{
  "type": "object",
  "required": ["updated_at", "items"],
  "additionalProperties": false,
  "properties": {
    "updated_at": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "rss_pub_date", "cves", "first_seen_at", "last_changed_at"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^\\d{4}-\\d{3,}-aws$" },
          "title": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://aws\\.amazon\\.com/security/security-bulletins/" },
          "rss_pub_date": { "type": "string" },
          "cves": { "$ref": "common#/definitions/strArray" },
          "first_seen_at": { "type": "string" },
          "last_changed_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
